{
  "name": "@danielsharp/http-auth",
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@danielsharp/common": "workspace:*"
  },
  "peerDependencies": {
    "@danielsharp/auth": "workspace:*",
    "@danielsharp/typeline-http": "workspace:*",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "benchmark": "vitest bench --project @danielsharp/http-auth",
    "check": "tsc --noEmit",
    "test": "vitest run --project @danielsharp/http-auth",
    "test:types": "vitest run --typecheck.only --project @danielsharp/http-auth"
  },
  "devDependencies": {
    "@danielsharp/auth": "workspace:*",
    "@danielsharp/typeline-http": "workspace:*",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
