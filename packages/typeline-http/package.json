{
  "name": "@danielsharp/typeline-http",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@danielsharp/common": "workspace:*",
    "@scalar/openapi-types": "catalog:",
    "busboy": "catalog:",
    "mime-types": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "benchmark": "vitest bench --project @danielsharp/typeline-http",
    "check": "tsc --noEmit",
    "test": "vitest run --project @danielsharp/typeline-http",
    "test:types": "vitest run --typecheck.only --project @danielsharp/typeline-http"
  },
  "devDependencies": {
    "@danielsharp/typeline": "workspace:*",
    "@danielsharp/zod": "workspace:*",
    "@hyperjump/json-schema": "catalog:",
    "@types/busboy": "catalog:",
    "@types/express": "catalog:",
    "@types/mime-types": "catalog:",
    "express": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "@danielsharp/typeline": "workspace:*",
    "@danielsharp/zod": "workspace:*",
    "zod": "catalog:"
  }
}
